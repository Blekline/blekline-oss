# Generated by scripts/generate-mcp-configs.mjs — placeholder token only

[mcp_servers.blekline]
command = "node"
args = ["packages/mcp-server/dist/index.js"]
enabled = true
startup_timeout_sec = 30

[mcp_servers.blekline.env]
BLEKLINE_API_URL = "https://app.blekline.com"
BLEKLINE_WORKSPACE_TOKEN = "blw_replace_with_workspace_token"
BLEKLINE_CLIENT_SURFACE = "codex"

[mcp_servers.blekline-proxy]
command = "node"
args = ["packages/mcp-proxy/dist/index.js"]
enabled = true

[mcp_servers.blekline-proxy.env]
BLEKLINE_API_URL = "https://app.blekline.com"
BLEKLINE_WORKSPACE_TOKEN = "blw_replace_with_workspace_token"
BLEKLINE_MCP_PROXY_MOCK = "1"
BLEKLINE_CLIENT_SURFACE = "codex"
