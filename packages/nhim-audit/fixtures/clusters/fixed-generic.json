{
  "clusterName": "kind-nhim-fixed-generic",
  "namespaces": ["default", "istio-system"],
  "pods": [],
  "deployments": [
    {
      "namespace": "default",
      "name": "langgraph-worker",
      "labels": { "app": "langgraph-worker", "app.kubernetes.io/component": "agent" },
      "annotations": { "sidecar.istio.io/status": "{\"version\":\"1.22\"}" },
      "containers": ["langgraph-worker", "istio-proxy"],
      "envKeys": ["OPENAI_API_KEY", "OPENAI_BASE_URL", "HTTP_PROXY"],
      "image": "langchain/langgraph-api:latest"
    }
  ],
  "replicaSets": [],
  "statefulSets": [],
  "jobs": [],
  "cronJobs": [],
  "networkPolicies": [
    {
      "namespace": "default",
      "name": "mandatory-hop",
      "podSelector": { "app": "langgraph-worker" },
      "policyTypes": ["Egress"],
      "egressRestricted": true,
      "allowsSidecarHop": true,
      "allowsWideHttpsEgress": false
    }
  ],
  "mutatingWebhooks": [
    {
      "name": "sidecar-inject-mutate",
      "failurePolicy": "Fail",
      "matchesBlekline": false,
      "matchesEnforcement": true
    }
  ],
  "validatingWebhooks": [],
  "services": [
    {
      "namespace": "istio-system",
      "name": "istio-ingressgateway",
      "type": "ClusterIP",
      "ports": [15001],
      "selector": { "istio": "ingressgateway" }
    }
  ],
  "secrets": [{ "namespace": "default", "name": "agent-sidecar-auth" }],
  "hasGatekeeper": false,
  "hasKyverno": true,
  "hasIstioAuthPolicy": true,
  "hasBleklineHelm": false
}
