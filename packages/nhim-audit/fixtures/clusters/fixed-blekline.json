{
  "clusterName": "kind-nhim-fixed-blekline",
  "namespaces": ["default", "blekline"],
  "pods": [],
  "deployments": [
    {
      "namespace": "default",
      "name": "langgraph-worker",
      "labels": { "app": "langgraph-worker", "app.kubernetes.io/component": "agent" },
      "annotations": { "blekline.com/inject-sidecar": "enabled" },
      "containers": ["langgraph-worker", "blekline-sidecar"],
      "envKeys": ["OPENAI_API_KEY", "BLEKLINE_SIDECAR_URL", "OPENAI_BASE_URL", "BLEKLINE_AUTO_ROUTE"],
      "image": "langchain/langgraph-api:latest"
    }
  ],
  "replicaSets": [],
  "statefulSets": [],
  "jobs": [],
  "cronJobs": [],
  "networkPolicies": [
    {
      "namespace": "default",
      "name": "agent-egress-deny",
      "podSelector": { "app": "langgraph-worker" },
      "policyTypes": ["Egress"],
      "egressRestricted": true,
      "allowsSidecarHop": true,
      "allowsWideHttpsEgress": false
    }
  ],
  "mutatingWebhooks": [
    {
      "name": "blekline-admission",
      "failurePolicy": "Fail",
      "matchesBlekline": true,
      "matchesEnforcement": true
    }
  ],
  "validatingWebhooks": [],
  "services": [
    {
      "namespace": "blekline",
      "name": "blekline-sidecar",
      "type": "ClusterIP",
      "ports": [8787],
      "selector": { "app": "blekline-sidecar" }
    }
  ],
  "secrets": [{ "namespace": "default", "name": "blekline-sidecar-auth" }],
  "hasGatekeeper": true,
  "hasKyverno": false,
  "hasIstioAuthPolicy": false,
  "hasBleklineHelm": true
}
