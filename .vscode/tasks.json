{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "blekline: build packages",
      "type": "shell",
      "command": "pnpm build:packages",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "blekline: verify integrations",
      "type": "shell",
      "command": "pnpm verify:integrations",
      "group": "test"
    },
    {
      "label": "blekline: MCP smoke",
      "type": "shell",
      "command": "pnpm demo:mcp-smoke",
      "dependsOn": ["blekline: build packages"],
      "group": "test"
    },
    {
      "label": "blekline: generate MCP configs (local)",
      "type": "shell",
      "command": "pnpm generate:mcp-configs:local",
      "group": "none"
    }
  ]
}
