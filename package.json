{
  "name": "blekline-oss",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Blekline production agent interaction governance — MCP, SDK, open core",
  "repository": {
    "type": "git",
    "url": "https://github.com/Blekline/blekline-oss.git"
  },
  "bugs": {
    "url": "https://github.com/Blekline/blekline-oss/issues"
  },
  "homepage": "https://github.com/Blekline/blekline-oss#readme",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "build:packages": "pnpm --filter @blekline/contracts build && pnpm --filter @blekline/client build && pnpm --filter @blekline/mcp-server build && pnpm --filter @blekline/mcp-proxy build && pnpm --filter @blekline/cursor-hooks build",
    "demo:cursor-hook-smoke": "node scripts/cursor-hook-smoke.mjs",
    "generate:mcp-configs": "node scripts/generate-mcp-configs.mjs --oss",
    "verify:integrations": "node scripts/verify-client-surfaces.mjs && node scripts/verify-integration-configs.mjs",
    "test:python": "python3 -m pip install --upgrade pip -q && python3 -m pip install -e \"packages/client-python[dev]\" -q && python3 -m pytest packages/client-python/tests -q",
    "demo:mcp-smoke": "node scripts/mcp-smoke.mjs",
    "demo:sdk": "node scripts/demo-sdk.mjs",
    "demo:latency": "node scripts/demo-latency.mjs",
    "demo:daytona-smoke": "SANDBOX_PROVIDER=daytona tsx demo/sandbox-smoke/index.ts",
    "demo:sandbox-smoke": "tsx demo/sandbox-smoke/index.ts",
    "docker:ingress": "docker build -t blekline-ingress -f packages/ingress-proxy/Dockerfile ."
  },
  "dependencies": {
    "@blekline/client": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  }
}
