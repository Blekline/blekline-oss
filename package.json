{
  "name": "blekline-oss",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Blekline production agent interaction governance — MCP, SDK, open core",
  "repository": {
    "type": "git",
    "url": "https://github.com/Blekline/blekline-oss.git"
  },
  "bugs": {
    "url": "https://github.com/Blekline/blekline-oss/issues"
  },
  "homepage": "https://github.com/Blekline/blekline-oss#readme",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "build:packages": "pnpm --filter @blekline/contracts build && pnpm --filter @blekline/client build && pnpm --filter @blekline/claude-sdk build && pnpm --filter @blekline/client-hooks build && pnpm --filter @blekline/mcp-server build && pnpm --filter @blekline/mcp-proxy build && pnpm --filter @blekline/cursor-hooks build && pnpm --filter @blekline/codex-hooks build && pnpm --filter @blekline/init build && pnpm --filter @blekline/nhim-audit build",
    "demo:cursor-hook-smoke": "node scripts/cursor-hook-smoke.mjs",
    "demo:codex-hook-smoke": "node scripts/codex-hook-smoke.mjs",
    "demo:vscode-extension-smoke": "node vscode-extension/scripts/smoke.mjs",
    "generate:mcp-configs": "node scripts/generate-mcp-configs.mjs --oss",
    "verify:integrations": "node scripts/verify-client-surfaces.mjs && node scripts/verify-integration-configs.mjs",
    "test:python": "python3 -m pip install --upgrade pip -q && python3 -m pip install -e \"packages/client-python[dev]\" -q && python3 -m pytest packages/client-python/tests -q",
    "demo:mcp-smoke": "node scripts/mcp-smoke.mjs",
    "demo:sdk": "node scripts/demo-sdk.mjs",
    "demo:latency": "node scripts/demo-latency.mjs",
    "audit:oss-public": "node scripts/audit-oss-public.mjs",
    "demo:cursor-plugin-submission-audit": "node scripts/cursor-plugin-submission-audit.mjs",
    "demo:codex-plugin-submission-audit": "node scripts/codex-plugin-submission-audit.mjs",
    "demo:daytona-smoke": "SANDBOX_PROVIDER=daytona tsx demo/sandbox-smoke/index.ts",
    "demo:sandbox-smoke": "tsx demo/sandbox-smoke/index.ts",
    "docker:ingress": "docker build -t blekline-ingress -f packages/ingress-proxy/Dockerfile .",
    "test:nhim-audit:e2e": "node scripts/test-nhim-audit-e2e.mjs"
  },
  "dependencies": {
    "@blekline/client": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "hono": "^4.13.5",
      "ip-address": "^10.7.0",
      "fast-uri": "^4.1.3",
      "body-parser": "^2.3.0",
      "esbuild": "^0.28.2"
    }
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  }
}
